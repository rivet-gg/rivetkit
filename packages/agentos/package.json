{
	"name": "@rivet-dev/agentos",
	"version": "0.0.1",
	"description": "The agentOS runtime SDK.",
	"license": "Apache-2.0",
	"keywords": [
		"rivetkit",
		"agent-os",
		"agentos",
		"runtime"
	],
	"sideEffects": false,
	"files": [
		"dist",
		"package.json"
	],
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "pnpm --dir ../agentos-bindgen check && tsup src/index.ts",
		"check-types": "pnpm --dir ../agentos-bindgen check && tsc --noEmit"
	},
	"dependencies": {
		"rivetkit": "catalog:rivetkit"
	},
	"devDependencies": {
		"@rivet-dev/agentos-bindgen": "workspace:*",
		"tsup": "^8.4.0",
		"typescript": "^5.7.3"
	}
}
